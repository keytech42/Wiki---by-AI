#!/usr/bin/env bash
# Git commit-msg hook to enforce Conventional Commits and 2-Turn Protocol

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Enforce Conventional Commits
if ! echo "$COMMIT_MSG" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?: .+$'; then
    echo "❌ [Git Hook Error] Invalid commit message format."
    echo "   Commit message must follow Conventional Commits."
    echo "   Valid example: 'feat(infra): add pre-commit hook'"
    echo "   Your message: $COMMIT_MSG"
    exit 1
fi

echo "✅ Commit message validation passed."
