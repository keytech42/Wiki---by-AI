#!/usr/bin/env bash
# Git pre-commit hook to enforce Hard Rules (Zettelkasten Integrity)

echo "=========================================================="
echo "🛡️ [System Control] Running Pre-Commit Validations"
echo "=========================================================="

STAGED_MD=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.md$' || true)

if [[ -n "$STAGED_MD" ]]; then
    while IFS= read -r file; do
        # Rule 1: 10_Concepts notes must have tags for multi-clustering
        if [[ "$file" == 10_Concepts/* ]]; then
            # Check the first 15 lines for frontmatter tags
            if ! head -n 15 "$file" | grep -q "^tags:"; then
                echo "❌ [Zettelkasten Linter Error] $file"
                echo "   Missing 'tags:' in YAML frontmatter."
                echo "   Rule: Concept notes MUST use tag-based multi-clustering."
                exit 1
            fi
        fi
    done <<< "$STAGED_MD"
    echo "✅ Zettelkasten Linter passed."
fi
